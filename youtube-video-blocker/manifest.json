{
  "manifest_version": 3,
  "name": "YouTube Video Blocker",
  "version": "1.1",
  "description": "Blocks distracting music videos with a helpful frog friend, hides the sidebar and drops video quality to the lowest setting.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["quality.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
